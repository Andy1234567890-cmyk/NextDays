[Unit]
Description=NextDays Off-site-Backup (Postgres-Dumps + Supabase-Storage → Hetzner Storage Box via Borg)
Documentation=https://github.com/Andy54411/NextDays/blob/main/deploy/backup/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nextdays-backup.env
ExecStart=/usr/local/bin/nextdays-backup.sh
# Backup darf laufen, ohne den Host zu belasten.
Nice=10
IOSchedulingClass=idle
# WICHTIG: ProtectHome NICHT setzen — der Backup-SSH-Key, die age-Identity und die
# known_hosts liegen in /root/.ssh bzw. /root. ProtectHome=true macht /root für den
# Service unsichtbar → SSH zur Storage Box scheitert ("Identity file not accessible",
# "/root/.ssh Read-only"). Der Service läuft als root und ist auf diese Secrets
# angewiesen; die Härtung würde genau den Off-site-Push verhindern.
PrivateTmp=false
TimeoutStartSec=3600
