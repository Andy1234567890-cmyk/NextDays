# NextDays Backup-Konfiguration — NUR Variablen-NAMEN, KEINE echten Werte.
#
# Echte Werte trägt Andy in die root-only Datei  /etc/nextdays-backup.env  ein:
#     sudo cp deploy/backup/nextdays-backup.env.example /etc/nextdays-backup.env
#     sudo chmod 600 /etc/nextdays-backup.env
#     sudo nano /etc/nextdays-backup.env      # Werte eintragen
#
# Diese Datei (.example) wird versioniert; /etc/nextdays-backup.env NIEMALS committen.

# === Off-site-Ziel: Hetzner Storage Box (BorgBackup) ========================
# Storage Box im Hetzner-Konto anlegen (idealerweise anderes RZ als der Server).
# SSH-Key des Servers (/root/.ssh/id_ed25519.pub) in der Storage-Box-Verwaltung
# hinterlegen. Borg-Repo einmalig initialisieren (siehe README, Schritt „Init").
# Port 23 = Storage-Box-SSH.
BORG_REPO="ssh://uXXXXXX@uXXXXXX.your-storagebox.de:23/./nextdays-borg"
BORG_PASSPHRASE="<langes-zufälliges-passwort-für-das-borg-repo>"

# === Verschlüsselung der DB-Dumps (age, Defense-in-Depth) ====================
# Öffentlicher age-Recipient verschlüsselt den Dump-Inhalt VOR dem Push.
# Schlüsselpaar einmalig erzeugen:  age-keygen -o /root/age-backup.key
# AGE_RECIPIENT = die "Public key:"-Zeile daraus. Private Datei nur für Restore.
AGE_RECIPIENT="age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Nur für restore-test.sh / Disaster-Recovery (private Identität):
AGE_IDENTITY_FILE="/root/age-backup.key"

# === Monitoring (Dead-man-Ping + Disk-Alert) =================================
# Erfolgs-Ping NUR bei erfolgreichem Backup; fehlender Ping = Alarm im Monitor
# (z. B. healthchecks.io, Uptime-Kuma Push-Monitor).
BACKUP_PING_URL=""
# Disk-Alert-Ziele (Ping und/oder Mail). Schwelle in Prozent.
DISK_ALERT_PING_URL=""
DISK_ALERT_MAIL=""
DISK_ALERT_THRESHOLD="80"

# === Optionale Overrides (Defaults im Skript sind bereits korrekt) ===========
# POSTGRES_IMAGE="supabase/postgres:15.14.1.138"
# PG_USER="supabase_admin"
# STORAGE_DIR="/mnt/HC_Volume_106086998/nextdays/storage"
# DATABASES="postgres _supabase"
# RETENTION_DAILY="7"
# RETENTION_WEEKLY="4"
# RETENTION_MONTHLY="6"
# DISK_CHECK_MOUNTS="/ /mnt/HC_Volume_106086998"
