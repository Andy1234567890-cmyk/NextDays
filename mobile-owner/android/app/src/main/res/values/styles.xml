<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- DUNKLE Systemsymbole in der Statusleiste.

             Warum das hier stehen MUSS (gemessen 15.09.2026): targetSdk 36
             erzwingt Edge-to-Edge, der App-Grund liegt also UNTER der
             Statusleiste. Ohne diesen Schalter zeichnet Android weisse
             Symbole — auf `palette.bg` (#F5F3F0) sind das 1,11:1, auf einer
             weissen Kopfzeile 1,00:1. Uhr, WLAN, Signal und Akku waren damit
             auf jedem Bildschirm unsichtbar, nicht nur schlecht lesbar.
             Die App setzt nirgends <StatusBar>, es gibt also keine zweite
             Stelle, an der das noch geradegezogen wuerde.
             Die Nachtfassung steht in values-night/styles.xml. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- DayNight statt Theme.AppCompat.NoActionBar: der native Startbildschirm
         lag fest auf Weiss und blitzte im Dunkelmodus vor der dunklen App auf.
         Farbe und Symbolton kommen jetzt aus der Tag-/Nacht-Fassung. -->
    <style name="SplashTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background_color</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
