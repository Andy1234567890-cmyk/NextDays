{
  "name": "nextdays-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "NextDays Monorepo — 1 FastAPI-Backend (apps/api) + mehrere eigenständige Frontends (Top-Level) + geteilte packages/ (ADR-0015/0016). Package-Manager: bun (Workspaces).",
  "workspaces": [
    "web",
    "admin",
    "partner",
    "marketing",
    "builder",
    "storybook",
    "packages/*"
  ],
  "packageManager": "bun@1.3.9",
  "scripts": {
    "lint:packages": "cd packages && eslint . --pass-on-unpruned-suppressions",
    "spaghetti": "bash scripts/qualitaet/spaghetti-gate.sh",
    "spaghetti:neu": "bash scripts/qualitaet/spaghetti-gate.sh --neu",
    "spaghetti:bericht": "python3 scripts/qualitaet/komplexitaet-ratchet.py --bericht"
  },
  "devDependencies": {
    "@iconify/json": "2.2.517",
    "@nextdays/eslint-config": "workspace:*",
    "eslint": "10.8.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "brace-expansion": "5.0.9",
    "sharp": "0.35.3"
  }
}
