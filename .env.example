# .env.example — Root-Übersicht der Umgebungsvariablen für NextDays
#
# Dies ist eine ZENTRALE ÜBERSICHT. Die tatsächlich geladenen .env-Dateien
# liegen pro App:
#   - apps/api/.env   (kopiere von apps/api/.env.example)
#   - apps/web/.env.local  (kopiere von apps/web/.env.example)
#
# NIEMALS echte Secrets committen. Alle Werte hier sind Platzhalter.
# Im Backend werden Secrets ausschließlich als pydantic SecretStr geladen,
# nie als nacktes str (CLAUDE.md, harte Konvention).

# --- Supabase (lokal via Supabase CLI: `supabase start`) ---
# Standard-Ports des lokalen Stacks. Die echten anon/service-keys gibt
# `supabase start` beim ersten Start im Terminal aus.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=changeme-anon-key
SUPABASE_SERVICE_ROLE_KEY=changeme-service-role-key
SUPABASE_JWT_SECRET=changeme-jwt-secret

# --- Redis (Cache + Background-Queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Externe Dienste (Platzhalter, erst bei Bedarf füllen) ---
GOOGLE_MAPS_API_KEY=changeme
GOOGLE_TRANSLATE_API_KEY=changeme
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme
