# .env.example — Root-Übersicht der Umgebungsvariablen für NextDays
#
# Dies ist eine ZENTRALE ÜBERSICHT. Die tatsächlich geladenen .env-Dateien
# liegen pro App:
#   - apps/api/.env   (kopiere von apps/api/.env.example)
#   - apps/web/.env.local  (kopiere von apps/web/.env.example)
#
# NIEMALS echte Secrets committen. Alle Werte hier sind Platzhalter.
# Im Backend werden Secrets ausschließlich als pydantic SecretStr geladen,
# nie als nacktes str (PROJECT.md, harte Konvention).

# --- Supabase (lokal via Supabase CLI: `supabase start`) ---
# Standard-Ports des lokalen Stacks. Die echten anon/service-keys gibt
# `supabase start` beim ersten Start im Terminal aus.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=changeme-anon-key
SUPABASE_SERVICE_ROLE_KEY=changeme-service-role-key
SUPABASE_JWT_SECRET=changeme-jwt-secret

# --- Redis (Cache + Background-Queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Externe Dienste (Platzhalter, erst bei Bedarf füllen) ---
GOOGLE_MAPS_API_KEY=changeme
GOOGLE_TRANSLATE_API_KEY=changeme
REVOLUT_API_KEY=changeme
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme
# Signaturschlüssel des CONNECT-Webhook-Endpunkts (Events aus den
# verbundenen Stripe-Konten der Betriebe, u. a. checkout.session.completed).
# Eigener Endpunkt mit `connect: true` — ohne ihn erreicht KEIN
# Zahlungseingang einer Zusatzleistung/Nachberechnung den Webhook.
STRIPE_CONNECT_WEBHOOK_SECRET=changeme

# --- Google Vertex AI (KI-Assistent des Website-Baukastens) ---
# NICHT derselbe Anbieter wie GROQ_API_KEY oben: der Posteingang bleibt bei
# Groq, der Website-Baukasten laeuft ueber Vertex AI. Grund ist die
# Datenresidenz — Texte einer Kundenwebsite duerfen in der EU verarbeitet
# werden muessen, und Google sagt das fuer REGIONALE Endpunkte zu.
#
# Der Service-Account-Schluessel steht als EINZEILIGES Base64 des JSON-Files:
#   base64 -i schluessel.json | tr -d '\n'
# Einzeilig, weil eine mehrzeilige Variable den Coolify-Deploy zerbricht.
# NIE die Datei ins Repo legen — nur diese Variable, nur Platzhalter hier.
#
# Der Service-Account braucht GENAU EINE Rolle: roles/aiplatform.user.
# Im Projekt muss aiplatform.googleapis.com aktiviert sein:
#   gcloud services enable aiplatform.googleapis.com
#
# Fehlt die Variable, erscheint der KI-Assistent im Baukasten gar nicht
# (GET /api/v1/site-config/ki/status meldet verfuegbar=false) — es stuerzt
# nichts ab. Pruefen: python3 scripts/diagnose/ki-vertex-pruefen.py
VERTEX_SERVICE_ACCOUNT_B64=<DEIN_BASE64_SERVICE_ACCOUNT>
VERTEX_PROJECT_ID=<DEINE_GCP_PROJEKT_ID>
# EU-Region. europe-west4 (Niederlande) ist in Googles Datenresidenz-Tabelle
# fuer die Gemini-Modelle gelistet; europe-west1 steht dort nur als Beispiel.
VERTEX_LOCATION=europe-west4
VERTEX_MODEL=gemini-2.5-flash
# Wie viele KI-Aufrufe ein Betrieb je Kalendertag (UTC) machen darf. Kein
# Guthabensystem — nur der Schutz gegen die Schleife. Gezaehlt wird in
# site_ai_usage (0465); ein spaeteres Guthaben setzt darauf auf.
KI_TAGESLIMIT_JE_TENANT=200

# --- Frontend (NEXT_PUBLIC_*, im Browser sichtbar — nur publishable Keys!) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=changeme-publishable-key

# --- Schlösser (Seam) ---------------------------------------------------
# API-Key des Seam-Workspaces. In api UND worker setzen: die Oberfläche
# hängt an der API, der Automatikpfad (Grants 72 h vorher) am worker.
SEAM_API_KEY=<DEIN_WERT>
# Signing Secret der Webhooks (Svix). MEHRERE kommagetrennt möglich — jeder
# Seam-Endpunkt hat sein eigenes, und Sandbox wie Produktion senden an
# dieselbe URL. Fehlt der Wert, lehnt der Endpunkt mit 401 ab (fail-closed);
# ein nicht hinterlegtes Secret bedeutet endgültigen Verlust der Ereignisse,
# weil Svix bei 401 nicht wiederholt.
# Prüfen: scripts/diagnose/seam-webhook-pruefen.py
SEAM_WEBHOOK_SECRET=<DEIN_WERT>,<WEITERER_WERT>
