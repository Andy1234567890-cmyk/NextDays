# apps/api/.env.example — Backend-Umgebungsvariablen (Platzhalter)
#
# Kopieren: cp apps/api/.env.example apps/api/.env
# NIEMALS echte Secrets committen. Alle Secrets werden im Code als
# pydantic SecretStr geladen, nie als nacktes str (PROJECT.md).

APP_ENV=local
LOG_LEVEL=INFO

# --- Supabase ---
# Aus Sicht des API-Containers liegt der lokale Supabase-Stack (CLI) auf
# dem Host → host.docker.internal. Läuft die API ohne Container, ersetze
# durch http://localhost:54321.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=changeme-anon-key
SUPABASE_SERVICE_ROLE_KEY=changeme-service-role-key
SUPABASE_JWT_SECRET=changeme-jwt-secret

# --- Redis (Cache + Background-Queue) ---
# Im Compose-Netz ist der Hostname "redis"; standalone: localhost.
REDIS_URL=redis://redis:6379/0

# --- Externe Dienste (erst bei Bedarf füllen) ---
GOOGLE_MAPS_API_KEY=changeme
GOOGLE_TRANSLATE_API_KEY=changeme
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme

# --- Channex (Channel-Manager / OTA-Distribution) ---
# CHANNEX_BASE_URL: Staging = https://staging.channex.io/api/v1
#                   Produktion = https://app.channex.io/api/v1
# CHANNEX_WEBHOOK_SECRET: eigenes Zufalls-Secret, das wir Channex per Custom-
#   Header geben und im Webhook-Receiver prüfen (Channex signiert nicht via HMAC).
CHANNEX_API_KEY=changeme
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_WEBHOOK_SECRET=changeme
# Öffentliche HTTPS-URL DIESER API (für den Webhook-Callback von Channex).
# Dev: Tunnel-URL (z.B. ngrok), Prod: echte API-Domain. Leer = Webhook-Register
# gibt 400 (lokaler localhost ist von Channex nicht erreichbar).
PUBLIC_API_URL=
