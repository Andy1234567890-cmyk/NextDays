# apps/api/.env.example — Backend-Umgebungsvariablen (Platzhalter)
#
# Kopieren: cp apps/api/.env.example apps/api/.env
# NIEMALS echte Secrets committen. Alle Secrets werden im Code als
# pydantic SecretStr geladen, nie als nacktes str (PROJECT.md).

APP_ENV=local
LOG_LEVEL=INFO

# --- Supabase ---
# Aus Sicht des API-Containers liegt der lokale Supabase-Stack (CLI) auf
# dem Host → host.docker.internal. Läuft die API ohne Container, ersetze
# durch http://localhost:54321.
SUPABASE_URL=http://host.docker.internal:54321
# Von AUSSEN (Browser) erreichbare Adresse desselben Stacks. PFLICHT: aus ihr
# werden die gespeicherten Storage-Links (Logo, Fotos, Avatare) gebaut. Die
# interne Adresse oben taugt dafür nicht — sie ist im Browser unerreichbar.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=changeme-anon-key
SUPABASE_SERVICE_ROLE_KEY=changeme-service-role-key
SUPABASE_JWT_SECRET=changeme-jwt-secret

# --- Redis (Cache + Background-Queue) ---
# Im Compose-Netz ist der Hostname "redis"; standalone: localhost.
REDIS_URL=redis://redis:6379/0

# --- Externe Dienste (erst bei Bedarf füllen) ---
GOOGLE_MAPS_API_KEY=changeme
GOOGLE_TRANSLATE_API_KEY=changeme
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme
# Groq (KI-Antwortvorschläge im Posteingang / Dashboard-Assistent).
# Den Wert in der lokalen .env bzw. im Prod-Secret austauschen.
GROQ_API_KEY=changeme
# Portal-Provision (eigene Direktbuchung) in Prozent — laut Preisliste 8 % all-in.
# Wird als application_fee_amount beim Destination-Charge einbehalten und greift
# NUR fuer eigene Kanaele (portal/direct); OTA-Buchungen sind ausgeschlossen.
# Fehlt der Wert -> 0 % (keine Provision). >100 -> klarer Fehler (kein Charge).
STRIPE_PLATFORM_FEE_PCT=8

# --- PayPal (Complete Payments Platform / Multiparty) ---
# Partner-Credentials aus der PayPal-Developer-App (Type: Platform). Nur Platzhalter
# hier — echte Werte in die lokale .env / ins Prod-Secret. Sandbox testet ohne
# Partner-Approval; Live braucht Partner-Freischaltung + BN-Code + platform_fee-Enable.
PAYPAL_CLIENT_ID=changeme
PAYPAL_SECRET=changeme
# BN-Code (PayPal-Partner-Attribution-Id): App-Einstellungen -> Reports (letzte Zeile).
PAYPAL_BN_CODE=changeme
# Merchant-ID der Plattform (Empfaenger der Provision). Leer = Fee an API-Caller.
PAYPAL_PLATFORM_MERCHANT_ID=
# Webhook-ID aus POST /v1/notifications/webhooks (fuer die Signaturpruefung).
PAYPAL_WEBHOOK_ID=changeme
# Sandbox = https://api-m.sandbox.paypal.com ; Live = https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Oeffentliche client-id fuers Frontend-JS-SDK (NEXT_PUBLIC_).
PAYPAL_PUBLISHABLE_CLIENT_ID=changeme

# --- Channex (Channel-Manager / OTA-Distribution) ---
# CHANNEX_BASE_URL: Staging = https://staging.channex.io/api/v1
#                   Produktion = https://app.channex.io/api/v1
# CHANNEX_WEBHOOK_SECRET: eigenes Zufalls-Secret, das wir Channex per Custom-
#   Header geben und im Webhook-Receiver prüfen (Channex signiert nicht via HMAC).
CHANNEX_API_KEY=changeme
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_WEBHOOK_SECRET=changeme
# Öffentliche HTTPS-URL DIESER API (für den Webhook-Callback von Channex).
# Dev: Tunnel-URL (z.B. ngrok), Prod: echte API-Domain. Leer = Webhook-Register
# gibt 400 (lokaler localhost ist von Channex nicht erreichbar).
PUBLIC_API_URL=

# --- WhatsApp (Meta WhatsApp Cloud API) ---
# WHATSAPP_ACCESS_TOKEN: permanenter System-User-Token (Meta Business).
# WHATSAPP_PHONE_NUMBER_ID: ID der WhatsApp-Business-Nummer (Graph API).
# WHATSAPP_VERIFY_TOKEN: eigenes Zufalls-Secret für den Webhook-Verify (GET).
# WHATSAPP_SANDBOX=true → kein echter Meta-Call (lokal testen). Prod IMMER false.
# WHATSAPP_DEFAULT_TENANT_ID: ordnet eingehende Nachrichten neuer Nummern einem
#   Mandanten zu (eine globale Nummer). Leer → neue Nummern werden verworfen.
# WHATSAPP_WABA_ID: WhatsApp Business Account (Ebene über der Nummer) — nötig
#   für Vorlagen-Verwaltung (/whatsapp/templates, /templates/rollout).
# WHATSAPP_APP_ID: Meta-App-ID (oeffentlich) — fuer den Embedded-Signup-
#   Code-Tausch und debug_token beim Kunden-Onboarding.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# WHATSAPP_SIGNUP_CONFIG_ID: Konfigurations-ID hinter Metas gehosteter
#   Embedded-Signup-Seite (App-Dashboard -> Werde Tech-Anbieter -> Link
#   generieren). Ohne sie kann kein Betrieb seine Nummer verbinden.
WHATSAPP_APP_ID=
WHATSAPP_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_SANDBOX=false
WHATSAPP_DEFAULT_TENANT_ID=

# --- E-Mail-Versand (eigener Mailcow-Server, deploy/mail/) ---
# SMTP_HOST: der Mailcow-Server (z.B. mail.mynextdays.dk).
# SMTP_PORT: 587 = STARTTLS/Submission (empfohlen; Port 25/465 sind bei Hetzner
#   ausgehend geblockt). SMTP_STARTTLS=true dazu.
# SMTP_USER/SMTP_PASSWORD: ein echtes Mailcow-Postfach (z.B. developer@…), NICHT
#   der Admin.
# SMTP_FROM_ADDRESS: sichtbarer Absender; MUSS zu einer Mailcow-DKIM-Domain gehören.
# MAIL_SANDBOX=true → kein echter Versand, nur Log (lokal testen). Prod IMMER false.
# Leer (SMTP_HOST/SMTP_FROM_ADDRESS) → Versand deaktiviert, send() gibt 503
#   (kein stiller Erfolg, kein erfundener Absender).
# Öffentliche Adresse des Plattform-Backoffice (admin/). Nötig für die
# Einladungslinks des Backoffice-Teams, z. B. https://admin.mynextdays.com
ADMIN_BASE_URL=

# Öffentliche Adresse der Marketing-Seite (marketing/). Ziel der Bestätigungs-
# und Abmeldelinks aus den Newsletter-Mails.
MARKETING_BASE_URL=

# Öffentliche Adresse des myBestDays-Marktplatzes (plattform/). Ziel des Links in
# der Bewertungs-Erinnerung an den Gast. Fehlt sie, wird KEINE Erinnerung
# verschickt (der Tick loggt `review_reminder_ohne_basis_url`) — eine Mail mit
# geratener Domain wäre wertlos.
MARKETPLACE_BASE_URL=

# Brevo (NUR Newsletter/Marketing — Transaktionsmails laufen über den eigenen
# Mailserver). Der v3-Schlüssel beginnt mit "xkeysib-"; der MCP-Schlüssel aus
# demselben Konto funktioniert hier NICHT. BREVO_LIST_ID ist die Ziel-Liste der
# Voranmeldungen (GET /v3/contacts/lists). Betrieb: die Server-IP muss im
# Brevo-Konto unter „Authorized IPs" stehen, sonst antwortet Brevo mit 401.
BREVO_API_KEY=
BREVO_LIST_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=myNextDays
SMTP_STARTTLS=true
MAIL_SANDBOX=false

# --- Twilio (SMS-OTP für 2FA / Nummern-Verifizierung) ---
# Account SID + Auth Token aus der Twilio-Console (API keys & tokens).
# Trial: sendet nur an verifizierte Nummern. NIE echte Werte hier eintragen —
# nur in der gitignored .env.
TWILIO_ACCOUNT_SID=<DEINE_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<DEIN_AUTH_TOKEN>
TWILIO_FROM_NUMBER=<DEINE_TWILIO_NUMMER_E164>

# --- Coolify (Deploy-Monitor im Backoffice) ---
# Token anlegen: Coolify → Keys & Tokens → API tokens → "Create New Token",
# Berechtigung "read" genügt für die Anzeige; für den Redeploy-Knopf wird
# "deploy" zusätzlich gebraucht. Ohne diese Werte ist der Monitor sichtbar
# deaktiviert (503 mit Hinweis) statt mit Platzhaltern gefüllt.
# NIE echte Werte hier eintragen — nur in der gitignored .env bzw. als
# Umgebungsvariable der App nextdays-api in Coolify.
# ACHTUNG: NICHT COOLIFY_URL — den Namen belegt Coolify selbst.
COOLIFY_API_URL=<http://coolify:8080>
COOLIFY_TOKEN=<DEIN_API_TOKEN>
# EIGENER Token nur fuer Build-Logs: Coolify gibt `logs` nur mit der
# Berechtigung `read:sensitive` heraus, und die oeffnet zusaetzlich
# Webhook-Secrets und Cloud-Provider-Token. Deshalb getrennt halten:
# dieser Token bekommt read + read:sensitive und darf NICHT deployen.
# Fehlt er, laeuft der Monitor weiter, nur die Build-Ausgabe bleibt leer.
COOLIFY_LOG_TOKEN=<DEIN_LOG_TOKEN>
