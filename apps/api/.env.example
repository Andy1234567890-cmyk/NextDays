# apps/api/.env.example — Backend-Umgebungsvariablen (Platzhalter)
#
# Kopieren: cp apps/api/.env.example apps/api/.env
# NIEMALS echte Secrets committen. Alle Secrets werden im Code als
# pydantic SecretStr geladen, nie als nacktes str (PROJECT.md).

APP_ENV=local
LOG_LEVEL=INFO

# Erlaubte Frontend-Origins für CORS, komma-getrennt und OHNE Leerzeichen.
# Dev-Ports: web 3000, admin 3001, plattform 3100, gastgeber 3200, builder 3300.
# In Produktion NUR die echten HTTPS-Domänen eintragen, nie ein "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://localhost:3200,http://localhost:3300

# --- Supabase ---
# Aus Sicht des API-Containers liegt der lokale Supabase-Stack (CLI) auf
# dem Host → host.docker.internal. Läuft die API ohne Container, ersetze
# durch http://localhost:54321.
SUPABASE_URL=http://host.docker.internal:54321
# Von AUSSEN (Browser) erreichbare Adresse desselben Stacks. PFLICHT: aus ihr
# werden die gespeicherten Storage-Links (Logo, Fotos, Avatare) gebaut. Die
# interne Adresse oben taugt dafür nicht — sie ist im Browser unerreichbar.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=changeme-anon-key
SUPABASE_SERVICE_ROLE_KEY=changeme-service-role-key
SUPABASE_JWT_SECRET=changeme-jwt-secret

# --- Redis (Cache + Background-Queue) ---
# Im Compose-Netz ist der Hostname "redis"; standalone: localhost.
REDIS_URL=redis://redis:6379/0

# --- Externe Dienste (erst bei Bedarf füllen) ---
GOOGLE_MAPS_API_KEY=changeme
# Google Cloud Translation v2. Nötig für die Übersetzung von Inhalten, Airbnb-
# Bildtexten UND der Ankündigungen in die 24 EU-Amtssprachen (0347). Fehlt der
# Schlüssel, schlägt der Übersetzungslauf klar mit 503 fehl — es wird nie der
# Ausgangstext als „Übersetzung" abgelegt.
GOOGLE_TRANSLATE_API_KEY=changeme
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme
# Veröffentlichbarer Schlüssel (pk_…) — kein Secret, wandert als NEXT_PUBLIC_
# ins Frontend. Muss zum selben Stripe-Modus gehören wie STRIPE_SECRET_KEY,
# sonst lehnt Stripe das erzeugte PaymentIntent-Client-Secret ab.
STRIPE_PUBLISHABLE_KEY=changeme
# Groq (KI-Antwortvorschläge im Posteingang / Dashboard-Assistent).
# Den Wert in der lokalen .env bzw. im Prod-Secret austauschen.
GROQ_API_KEY=changeme
# Portal-Provision (eigene Direktbuchung) in Prozent — laut Preisliste 8 % all-in.
# Wird als application_fee_amount beim Destination-Charge einbehalten und greift
# NUR fuer eigene Kanaele (portal/direct); OTA-Buchungen sind ausgeschlossen.
# Fehlt der Wert -> 0 % (keine Provision). >100 -> klarer Fehler (kein Charge).
STRIPE_PLATFORM_FEE_PCT=8

# --- PayPal (Complete Payments Platform / Multiparty) ---
# Partner-Credentials aus der PayPal-Developer-App (Type: Platform). Nur Platzhalter
# hier — echte Werte in die lokale .env / ins Prod-Secret. Sandbox testet ohne
# Partner-Approval; Live braucht Partner-Freischaltung + BN-Code + platform_fee-Enable.
PAYPAL_CLIENT_ID=changeme
PAYPAL_SECRET=changeme
# BN-Code (PayPal-Partner-Attribution-Id): App-Einstellungen -> Reports (letzte Zeile).
PAYPAL_BN_CODE=changeme
# Merchant-ID der Plattform (Empfaenger der Provision). Leer = Fee an API-Caller.
PAYPAL_PLATFORM_MERCHANT_ID=
# Webhook-ID aus POST /v1/notifications/webhooks (fuer die Signaturpruefung).
PAYPAL_WEBHOOK_ID=changeme
# Sandbox = https://api-m.sandbox.paypal.com ; Live = https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Oeffentliche client-id fuers Frontend-JS-SDK (NEXT_PUBLIC_).
PAYPAL_PUBLISHABLE_CLIENT_ID=changeme

# --- Channex (Channel-Manager / OTA-Distribution) ---
# CHANNEX_BASE_URL: Staging = https://staging.channex.io/api/v1
#                   Produktion = https://app.channex.io/api/v1
# CHANNEX_WEBHOOK_SECRET: eigenes Zufalls-Secret, das wir Channex per Custom-
#   Header geben und im Webhook-Receiver prüfen (Channex signiert nicht via HMAC).
CHANNEX_API_KEY=changeme
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_WEBHOOK_SECRET=changeme
# Sandbox-Testkanäle im Verbinden-Dialog anzeigen — NUR Dev/Test. In Produktion
# zwingend false, sonst kann ein Betrieb einen Testkanal verbinden, der nie
# echte Buchungen liefert.
CHANNEX_SANDBOX_PORTALS=false
# Öffentliche HTTPS-URL DIESER API. Drei Verwender:
#   1. Webhook-Callback von Channex — Dev: Tunnel-URL (z.B. ngrok), Prod: echte
#      API-Domain. Leer = Webhook-Register gibt 400 (localhost ist von Channex
#      nicht erreichbar).
#   2. TrustedHost-Liste (der Host daraus wird immer ergänzt).
#   3. MCP-Connector (0385): steht als `resource`/`issuer` in der
#      OAuth-Discovery. Claude vergleicht den Wert EXAKT mit der URL, die der
#      Nutzer als Connector einträgt — hier gehört die API-Domain hin
#      (api.mynextdays.com), NICHT die Dashboard-Domain aus APP_BASE_URL.
#      Fehlt sie, antwortet die Discovery mit 503 statt eine Domain zu raten.
PUBLIC_API_URL=

# --- WhatsApp (Meta WhatsApp Cloud API) ---
# WHATSAPP_ACCESS_TOKEN: permanenter System-User-Token (Meta Business).
# WHATSAPP_PHONE_NUMBER_ID: ID der WhatsApp-Business-Nummer (Graph API).
# WHATSAPP_VERIFY_TOKEN: eigenes Zufalls-Secret für den Webhook-Verify (GET).
# WHATSAPP_SANDBOX=true → kein echter Meta-Call (lokal testen). Prod IMMER false.
# WHATSAPP_DEFAULT_TENANT_ID: ordnet eingehende Nachrichten neuer Nummern einem
#   Mandanten zu (eine globale Nummer). Leer → neue Nummern werden verworfen.
# WHATSAPP_WABA_ID: WhatsApp Business Account (Ebene über der Nummer) — nötig
#   für Vorlagen-Verwaltung (/whatsapp/templates, /templates/rollout).
# WHATSAPP_APP_ID: Meta-App-ID (oeffentlich) — fuer den Embedded-Signup-
#   Code-Tausch und debug_token beim Kunden-Onboarding.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# WHATSAPP_SIGNUP_CONFIG_ID: Konfigurations-ID hinter Metas gehosteter
#   Embedded-Signup-Seite (App-Dashboard -> Werde Tech-Anbieter -> Link
#   generieren). Ohne sie kann kein Betrieb seine Nummer verbinden.
WHATSAPP_APP_ID=
WHATSAPP_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
# App-Secret der Meta-App — damit wird die Signatur eingehender Webhooks
# geprüft (X-Hub-Signature-256). Fehlt es, antwortet der Webhook in
# Prod/Staging fail-CLOSED mit 503 statt ungeprüfte Nutzlasten zu verarbeiten;
# nur lokal wird die Prüfung übersprungen (Wurzel 5).
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_SANDBOX=false
WHATSAPP_DEFAULT_TENANT_ID=

# --- E-Mail-Versand (eigener Mailcow-Server, deploy/mail/) ---
# SMTP_HOST: der Mailcow-Server (z.B. mail.mynextdays.dk).
# SMTP_PORT: 587 = STARTTLS/Submission (empfohlen; Port 25/465 sind bei Hetzner
#   ausgehend geblockt). SMTP_STARTTLS=true dazu.
# SMTP_USER/SMTP_PASSWORD: ein echtes Mailcow-Postfach (z.B. developer@…), NICHT
#   der Admin.
# SMTP_FROM_ADDRESS: sichtbarer Absender; MUSS zu einer Mailcow-DKIM-Domain gehören.
# Sandbox (kein echter Versand, nur Log) greift bei APP_ENV=local VON SELBST —
#   auch wenn hier echte SMTP-Daten stehen. Nichts zu setzen. Nur wer vom eigenen
#   Rechner aus WIRKLICH versenden will, setzt MAIL_SANDBOX_OVERRIDE=false.
# Leer (SMTP_HOST/SMTP_FROM_ADDRESS) → Versand deaktiviert, send() gibt 503
#   (kein stiller Erfolg, kein erfundener Absender).
# Öffentliche Adresse des Plattform-Backoffice (admin/). Nötig für die
# Einladungslinks des Backoffice-Teams, z. B. https://admin.mynextdays.com
ADMIN_BASE_URL=

# Öffentliche Adresse des PMS-Dashboards (web/, myNextDays). Ziel der Einladungs-
# und Passwort-Reset-Links für Betriebs-Nutzer (0334). Produktiv steht hier
# https://app.mynextdays.com, lokal http://localhost:3000. Fehlt sie, schlägt die
# Einladung klar fehl, statt einen Link auf eine geratene Domain zu verschicken.
APP_BASE_URL=

# Öffentliche Adresse der Marketing-Seite (marketing/). Ziel der Bestätigungs-
# und Abmeldelinks aus den Newsletter-Mails.
MARKETING_BASE_URL=

# Öffentliche Adresse des myBestDays-Marktplatzes (plattform/). Ziel des Links in
# der Bewertungs-Erinnerung an den Gast. Fehlt sie, wird KEINE Erinnerung
# verschickt (der Tick loggt `review_reminder_ohne_basis_url`) — eine Mail mit
# geratener Domain wäre wertlos.
MARKETPLACE_BASE_URL=

# Brevo (NUR Newsletter/Marketing — Transaktionsmails laufen über den eigenen
# Mailserver). Der v3-Schlüssel beginnt mit "xkeysib-"; der MCP-Schlüssel aus
# demselben Konto funktioniert hier NICHT. BREVO_LIST_ID ist die Ziel-Liste der
# Voranmeldungen (GET /v3/contacts/lists). Betrieb: die Server-IP muss im
# Brevo-Konto unter „Authorized IPs" stehen, sonst antwortet Brevo mit 401.
BREVO_API_KEY=
BREVO_LIST_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=myNextDays
SMTP_STARTTLS=true
# MAIL_SANDBOX_OVERRIDE=false   # nur setzen, um lokal ECHT zu versenden

# --- Kontaktformular der Marketing-Seite (/kontakt) ---
# Zwei Postfächer, zwei Zuständigkeiten. Die Zuordnung Thema → Postfach steht im
# Code (features/contact/themen.py), die ADRESSEN hier — ein Postfachwechsel ist
# damit eine Variable, kein Deploy. Fehlt eine der beiden, nimmt das Formular für
# die betroffenen Themen nichts an (503); es gibt KEINEN Rückfall auf das andere
# Postfach: eine Sicherheitsmeldung im allgemeinen Posteingang wäre schlimmer als
# eine klar abgewiesene.
CONTACT_RECIPIENT_GENERAL=<info@DEINE_DOMAIN>
CONTACT_RECIPIENT_TECHNICAL=<developer@DEINE_DOMAIN>

# --- reCAPTCHA Enterprise (Google Cloud) — Spamschutz öffentlicher Formulare ---
# Einrichtung: Google-Cloud-Konsole → Sicherheit → reCAPTCHA → Schlüssel
# erstellen, Typ „Website", Bewertungsart „score-based" (unsichtbar), Domains
# eintragen (www.mynextdays.com + die Staging-Domain + localhost für Tests).
# Dann „reCAPTCHA Enterprise API" im Projekt aktivieren und einen API-Schlüssel
# anlegen, der auf diese API beschränkt ist.
# RECAPTCHA_SITE_KEY ist derselbe Wert, der im Frontend als
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY steht — stimmen die beiden nicht überein, ist
# JEDES Token ungültig.
# Kostenlos bis 10.000 Bewertungen/Monat je Organisation.
# Leer → lokal Sandbox (nur Protokoll), in Produktion 503: ein öffentliches
# Formular ohne geprüften Spamschutz nimmt nichts an.
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SITE_KEY=
# Ab welchem Score die Anfrage als menschlich gilt (0.0 Bot … 1.0 Mensch).
# 0.7, nicht Googles Startwert 0.5: ein score-basierter Schlüssel WEIST NICHTS AB,
# er bewertet — diese Zahl ist die Entscheidung. Ein Bot mit fernsteuertem echten
# Browser bekommt ein gültiges Token und liegt oft bei 0.3–0.7. Ein falsch
# abgewiesener Mensch sieht eine verständliche Meldung samt Postfach-Adressen,
# eine durchgelassene Bot-Mail nicht.
RECAPTCHA_MIN_SCORE=0.7
# CAPTCHA_SANDBOX_OVERRIDE=false   # nur setzen, um lokal ECHT zu prüfen

# --- Anbieterangaben in der Fußzeile ausgehender E-Mails ---
# Pflicht für geschäftliche Mails (dän. e-handelslov § 7 / EU-Geschäftsbrief):
# Firma, Rechtsform, Sitz, Registernummer, Kontaktweg. Die Werte stehen hier und
# NICHT im Code, damit eine Registeränderung keinen Deploy braucht. Dieselben
# Angaben pflegen die Frontends in `marketing/content/legal/anbieter.ts`.
# Fehlt ein Wert, entfällt die Zeile; fehlt COMPANY_LEGAL_NAME, benennt die
# Fußzeile den Mangel — es wird nie eine Adresse oder Nummer erfunden.
COMPANY_LEGAL_NAME=
COMPANY_LEGAL_FORM=
COMPANY_STREET=
COMPANY_CITY=
COMPANY_COUNTRY=
# CVR-Nummer: rein 8-stellig, ohne „DK"-Präfix.
COMPANY_REGISTRATION_NUMBER=
# Umsatzsteuer-Identifikationsnummer (Momsnummer, „DK" + CVR) — NUR ausfüllen,
# wenn die Momsregistrierung tatsächlich vorliegt. Sonst leer lassen: § 7
# verlangt sie nur bei bestehender Registrierung, und eine nicht erteilte Nummer
# zu veröffentlichen wäre eine falsche Angabe.
COMPANY_VAT_ID=
COMPANY_CONTACT_EMAIL=
COMPANY_CONTACT_PHONE=

# --- Twilio (SMS-OTP für 2FA / Nummern-Verifizierung) ---
# Account SID + Auth Token aus der Twilio-Console (API keys & tokens).
# Trial: sendet nur an verifizierte Nummern. NIE echte Werte hier eintragen —
# nur in der gitignored .env.
TWILIO_ACCOUNT_SID=<DEINE_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<DEIN_AUTH_TOKEN>
TWILIO_FROM_NUMBER=<DEINE_TWILIO_NUMMER_E164>

# Darf die Oberfläche den SMS-Faktor (2FA) zur Einrichtung anbieten?
# ACHTUNG: Das hat mit den drei Werten oben NICHTS zu tun. Der Faktor läuft in
# GoTrue, einem eigenen Prozess mit eigener `GOTRUE_SMS_*`-Konfiguration
# (siehe deploy/ENVIRONMENT.md) — die Twilio-Werte hier versorgen nur den
# eigenen OTP-Weg der API.
#
# false (Default) = die Oberfläche führt SMS sichtbar als „nicht verfügbar",
# statt den Nutzer beim Anfordern des Codes in einen 500er laufen zu lassen.
# Erst auf true setzen, wenn GoTrue einen SMS-Anbieter hat UND das Twilio-Konto
# aufgewertet ist: ein Trial-Konto sendet nur an höchstens fünf zuvor in der
# Konsole verifizierte Nummern (Fehler 21608), ein Kunde kann seine eigene
# Nummer dort nicht eintragen.
MFA_SMS_AVAILABLE=false

# --- Coolify (Deploy-Monitor im Backoffice) ---
# Token anlegen: Coolify → Keys & Tokens → API tokens → "Create New Token",
# Berechtigung "read" genügt für die Anzeige; für den Redeploy-Knopf wird
# "deploy" zusätzlich gebraucht. Ohne diese Werte ist der Monitor sichtbar
# deaktiviert (503 mit Hinweis) statt mit Platzhaltern gefüllt.
# NIE echte Werte hier eintragen — nur in der gitignored .env bzw. als
# Umgebungsvariable der App nextdays-api in Coolify.
# ACHTUNG: NICHT COOLIFY_URL — den Namen belegt Coolify selbst.
COOLIFY_API_URL=<http://coolify:8080>
COOLIFY_TOKEN=<DEIN_API_TOKEN>
# EIGENER Token nur fuer Build-Logs: Coolify gibt `logs` nur mit der
# Berechtigung `read:sensitive` heraus, und die oeffnet zusaetzlich
# Webhook-Secrets und Cloud-Provider-Token. Deshalb getrennt halten:
# dieser Token bekommt read + read:sensitive und darf NICHT deployen.
# Fehlt er, laeuft der Monitor weiter, nur die Build-Ausgabe bleibt leer.
COOLIFY_LOG_TOKEN=<DEIN_LOG_TOKEN>

# --- GitHub (NUR LESEN) ------------------------------------------------------
# Beantwortet im Deploy-Monitor die Frage "was liegt zwischen dem ausgerollten
# Stand und main, und betrifft es diese Anwendung?". Die Zuordnung Commit ->
# Anwendung laeuft ueber Coolifys watch_paths.
# Token anlegen: GitHub -> Settings -> Developer settings -> Personal access
# tokens -> Fine-grained -> nur DIESES Repo, Repository permissions:
# "Contents: Read-only". Mehr braucht der Monitor nicht; er schreibt nie.
# Fehlt der Token, zeigt die Spalte "nicht abrufbar" statt "aktuell" — eine
# 0 waere die Behauptung, alles sei ausgerollt (Wurzel 4).
GITHUB_TOKEN=<DEIN_FINE_GRAINED_TOKEN>
GITHUB_REPO=Nextdays-AirSmil/NextDays

# Signatur-Schlüssel für die Vorschau-Token des Website-Baukastens (HMAC-SHA256).
# Ein zufälliger, langer Wert; pro Umgebung eigener. Fehlt er, verweigert der
# Draft-Endpunkt die Vorschau mit 503 (fail-closed) — es gibt bewusst KEINEN
# Fallback, sonst könnte jeder Token für fremde unveröffentlichte Seiten fälschen.
# Erzeugen: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SITE_DRAFT_SECRET=<DEIN_WERT>

# --- Custom-Domains der Kunden-Websites (Cloudflare for SaaS) ---------------
# Der Betrieb trägt im Baukasten seine eigene Domain ein; das Backend legt dafür
# einen Cloudflare-Custom-Hostname an und liefert die zwei DNS-Einträge zurück,
# die der Kunde bei seinem Anbieter setzen muss. Fehlt eines der drei Felder,
# antworten die Domain-Endpunkte mit 503 (fail-closed) — die Domain-Verwaltung
# ist dann nicht bedienbar, der übrige Baukasten läuft weiter.
#
# Diese drei fehlten hier bis zum 24.08.2026, obwohl sie in
# deploy/ENVIRONMENT.md stehen: wer nach dieser Datei eine Umgebung aufsetzt,
# kannte sie also nicht.
#
# FALLBACK_ORIGIN ist der Host, auf den Cloudflare die Kunden-Domains leitet —
# also der Origin der Renderer-App `nextdays-builder`, NICHT der des Dashboards.
CLOUDFLARE_API_TOKEN=<DEIN_WERT>
CLOUDFLARE_ZONE_ID=<DEIN_WERT>
CLOUDFLARE_FALLBACK_ORIGIN=<DEIN_WERT>
