# apps/web/.env.example — Frontend-Umgebungsvariablen (Platzhalter)
#
# Kopieren: cp apps/web/.env.example apps/web/.env.local
# Nur NEXT_PUBLIC_*-Variablen landen im Browser-Bundle — hier KEINE
# Service-Role-Keys oder anderen Secrets ablegen.

# FastAPI-Backend (lokal). Next.js ist reines Frontend, keine API-Routes.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (Remote-Projekt oder lokaler Stack). Nur publishable Key im Browser!
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=changeme-publishable-key

# Google Maps (Frontend-Key, in Google Cloud per HTTP-Referrer absichern).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=changeme
