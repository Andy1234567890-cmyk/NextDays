# apps/web/.env.example — Frontend-Umgebungsvariablen (Platzhalter)
#
# Kopieren: cp apps/web/.env.example apps/web/.env.local
# Nur NEXT_PUBLIC_*-Variablen landen im Browser-Bundle — hier KEINE
# Service-Role-Keys oder anderen Secrets ablegen.

# FastAPI-Backend (lokal). Next.js ist reines Frontend, keine API-Routes.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (Remote-Projekt oder lokaler Stack). Nur publishable Key im Browser!
# Social-Login (Google) läuft über Supabase Auth: Provider + Client-Secret
# werden NUR im Supabase-Dashboard hinterlegt — niemals hier. Redirect-Callback
# ist https://<project-ref>.supabase.co/auth/v1/callback (in Google Cloud + in
# Supabase URL-Konfiguration als Redirect-URL eintragen).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=changeme-publishable-key

# Google Maps (Frontend-Key, in Google Cloud per HTTP-Referrer absichern).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=changeme

# Google Fonts Developer API (Website-Baukasten → Typography-Schrift-Picker).
# SERVER-only (KEIN NEXT_PUBLIC_) — wird ausschließlich in /api/google-fonts
# genutzt, landet nie im Browser-Bundle. Key erstellen:
#   console.cloud.google.com → „Web Fonts Developer API" aktivieren → API-Key.
# In Produktion in die Coolify-Env, nicht ins Repo.
GOOGLE_FONTS_API_KEY=changeme
