# apps/public-api/.env.example — Vorlage für die lokale Entwicklung.
#
# Kopieren nach `.env` und die Platzhalter ersetzen. NIEMALS echte Werte in
# diese Datei schreiben: sie liegt im Repo, und ein Secret darin ist ein
# rotiertes Secret.
#
# Nur DREI Werte teilt dieser Dienst zwangsläufig mit `apps/api` — die
# Datenbank, ihr Zugang und das Signier-Secret der Tokens. Alles andere ist
# eigen, damit er nie versehentlich mit der Konfiguration der Haupt-API startet.

# -- Umgebung ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# -- Datenbank --------------------------------------------------------------
# Lokal: die Supabase-Instanz aus docker-compose. Im Container: http://kong:8000
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=<DEIN_SERVICE_ROLE_KEY>

# -- Auth -------------------------------------------------------------------
# MUSS mit `API_TOKEN_SECRET` in apps/api übereinstimmen: dort entstehen die
# Zugänge, hier werden die Tokens ausgegeben und geprüft. Zwei verschiedene
# Werte heißen, dass ein im Dashboard angelegter Zugang hier nicht funktioniert.
# Mindestens 32 Zeichen (RFC 7518 für HS256).
API_TOKEN_SECRET=<DEIN_SIGNIER_SECRET_MIT_MINDESTENS_32_ZEICHEN>

# -- Rate-Limits ------------------------------------------------------------
# EIGENE Redis-Datenbank (…/1), nicht die der Haupt-API (…/0): die Zähler beider
# Dienste dürfen sich keine Schlüssel teilen.
REDIS_URL=redis://localhost:6379/1
# Form "<max>/<sekunden>". Ein ungültiger Wert lässt den Start scheitern —
# absichtlich, statt still auf einen Standardwert zurückzufallen.
RATE_LIMIT_READ=600/60
RATE_LIMIT_WRITE=120/60
RATE_LIMIT_TOKEN=10/60
# Vertrauenswürdige Proxy-Hops für X-Forwarded-For. Lokal 0 (kein Proxy);
# hinter Traefik ebenfalls 0. Ein zu hoher Wert lässt eine gefälschte
# Client-IP durch und macht das IP-Limit wirkungslos.
TRUSTED_PROXY_HOPS=0

# -- Grenzen ----------------------------------------------------------------
MAX_PAGE_SIZE=200
MAX_DATE_SPAN_DAYS=730

# -- Webhook-Zustellung -----------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_POLL_SECONDS=5
# Nach so vielen aufeinanderfolgenden Fehlversuchen wird ein Abo mit benanntem
# Grund abgeschaltet. Ein Erfolg setzt den Zähler zurück.
WEBHOOK_ABO_ABSCHALTEN_AB=50

# -- Veröffentlichte Basis-Adresse ------------------------------------------
# Steht als `servers[0].url` in der OpenAPI-Datei. Lokal die eigene Adresse,
# sonst generieren Kunden Clients gegen einen Host, den es nicht gibt.
PUBLIC_BASE_URL=http://localhost:8100
