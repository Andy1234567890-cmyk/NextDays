# Build-Ausgabe eines Prüf-Builds mit relativem NEXT_DIST_DIR. Next.js legt den
# Pfad unter der App an statt absolut — daraus wurde web/private/ mit tausenden
# Dateien im git status, und die mitgeschriebenen Scratchpad-Pfade in
# tsconfig.json/next-env.d.ts liessen den Docker-Build scheitern (der Pfad
# existiert im Container nicht). Prüf-Builds gehören in ein eigenes Verzeichnis
# AUSSERHALB des Repos.
web/private/

# graphify: lokaler Wissensgraph, nicht versioniert
graphify-out/
graph.json
.claudeignore

# Amtliche DAC7-Vorlage: enthaelt eine ECHTE Meldung mit 18 CPR-Nummern,
# Namen, Anschriften und Bankverbindungen. Gehoert nicht ins Repo.
docs/Duck7/

# Produktwissen-Zwischendatei: Erzeugnis von
# marketing/scripts/produktwissen-sammeln.mjs, 8 MB, bei jedem Lauf neu.
# Die Quelle sind die Sprachdateien und Hilfe-Artikel im Repo, das Ziel ist
# die Tabelle `produktwissen` — dazwischen liegt nichts Aufbewahrenswertes.
produktwissen.json

# Arbeitsordner fuer Zwischenstaende einer Sitzung (Rueckweg-Skripte,
# Messreihen, Notizen). Nichts davon ist Quellcode; eingecheckt wuerde es
# nur die naechste Sitzung verwirren.
scratchpad/
