<?xml version="1.0" encoding="utf-8"?>
<!-- Runde Variante. Inhaltlich identisch zu ic_launcher.xml: bei einem
     adaptiven Icon bestimmt der LAUNCHER die Form, nicht das Bitmap — beide
     Verweise muessen aber existieren, weil das Manifest `android:icon` UND
     `android:roundIcon` fuehrt. Fehlte diese Datei, fiele die runde Variante
     auf `ic_launcher_round.png` zurueck und ein Geraet zeigte je nach
     Launcher-Einstellung zwei verschiedene Icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
