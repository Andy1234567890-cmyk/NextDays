{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tasko/ui": [
        "./vendor/tasko-ui/index.ts"
      ],
      "@tasko/ui/cn": [
        "./vendor/tasko-ui/lib/cn.ts"
      ],
      "@tasko/ui/*": [
        "./vendor/tasko-ui/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "/private/tmp/claude-501/-Users-andystaudinger-NextDays/1b03af2f-61d1-4b2c-b76b-0a05e2e2a1b7/scratchpad/next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
